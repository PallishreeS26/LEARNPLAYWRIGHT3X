console.log(tokens);
console.log(arr);

let maxElement = arr[0] ;  

for (let i = 1; i < arr.length; i++) {
    if (arr[i] > maxElement) {
        maxElement = arr[i];
    }   
}
console.log(`${maxElement}`);
